@dp.message(Command("start"))
async def start(message: Message):
    save_user(message.from_user)
    info = get_subscription_info(message.from_user.id)

    text = (
            FULL_DISCLAIMER +
            f"{info}\n\n"
            "Выберите монету в главном меню👇\n\n"
            "Если у вас нет аккаунта на бирже — создайте его прямо сейчас!"
    )

    # Inline-кнопка создания аккаунта
    inline_kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(
            text="🔗 Создать аккаунт на Binance",
            url="https://www.binance.com/referral/earn-together/refer2earn-usdc/claim?hl=ru&ref=GRO_28502_IS5P1&utm_source=referral_entrance"
        )]
    ])

    # 1. Отправляем сообщение с inline-кнопкой
    await message.answer(
        text,
        parse_mode="HTML",
        reply_markup=inline_kb
    )

    # 2. Отправляем основную клавиатуру отдельным сообщением
    if keyboard:
        await asyncio.sleep(0.3)  # небольшая задержка для корректного отображения
        await message.answer(
            "Выберите монету 👇",
            reply_markup=keyboard
        )

@dp.message(lambda m: m.text == "💰 Подписка")
async def subscription_menu(message: Message):
    info = get_subscription_info(message.from_user.id)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=f"1 месяц — {SUBSCRIPTION_PRICES['monthly']['price']} USDT", callback_data="pay_monthly")],
        [InlineKeyboardButton(text=f"3 месяца — {SUBSCRIPTION_PRICES['quarterly']['price']} USDT", callback_data="pay_quarterly")],
        [InlineKeyboardButton(text=f"1 год — {SUBSCRIPTION_PRICES['yearly']['price']} USDT", callback_data="pay_yearly")],
    ])
    await message.answer(f"💰 <b>Подписка USDT TRC20</b>\n\n{info}", parse_mode="HTML", reply_markup=kb)

@dp.callback_query(lambda c: c.data.startswith("pay_"))
async def process_payment(callback):
    plan_key = callback.data.replace("pay_", "")
    plan = SUBSCRIPTION_PRICES.get(plan_key)
    if not plan: return
    qr_bio, _ = generate_usdt_qr(plan["price"], callback.from_user.id)
    caption = f"🧾 <b>Оплата: {plan['name']}</b>\n\n💰 {plan['price']} USDT (TRC20)\n\nПришлите TxID"
    photo = BufferedInputFile(qr_bio.getvalue(), filename="qr.png")
    await callback.message.delete()
    await callback.message.answer_photo(photo, caption=caption, parse_mode="HTML")

@dp.message(lambda m: m.text and m.text.startswith("🔮"))
async def button_predict(message: Message):
    symbol = message.text.replace("🔮", "").strip()
    await predict_handler(message, symbol)

@dp.message(lambda m: m.text == "📋 Показать все монеты")
async def show_all_pairs(message: Message):
    global last_pairs_list
    try:
        pairs = get_futures_pairs()
        last_pairs_list = pairs[:]
        await message.answer(f"📋 Найдено <b>{len(pairs)}</b> активных пар.\n\nОтправь номер монеты:", parse_mode="HTML")

        text = ""
        for i, p in enumerate(pairs, 1):
            text += f"<b>{i}.</b> {p}\n"
            if i % 20 == 0:
                await message.answer(text, parse_mode="HTML")
                text = ""
                await asyncio.sleep(0.7)
        if text:
            await message.answer(text, parse_mode="HTML")
        await message.answer("🔢 <b>Напиши номер монеты:</b>", parse_mode="HTML")
    except:
        await message.answer("❌ Не удалось загрузить список")

@dp.message(lambda m: m.text and m.text.strip().isdigit())
async def handle_number_choice(message: Message):
    global last_pairs_list
    if not last_pairs_list:
        await message.answer("❌ Сначала нажми «📋 Показать все монеты»")
        return
    try:
        num = int(message.text.strip())
        if num < 1 or num > len(last_pairs_list):
            await message.answer("❌ Неверный номер!")
            return
        symbol = last_pairs_list[num - 1]
        await predict_handler(message, symbol)
    except:
        await message.answer("❌ Ошибка")

@dp.message(lambda m: m.text == "📊 Другая монета")
async def other_coin(message: Message):
    await message.answer(
        "✅ **Режим свободного ввода включён**\n\nПросто напиши название пары:\n• `BTCUSDT`\n• `ETH`\n• `SOL` и т.д.",
        parse_mode="Markdown"
    )

@dp.message()
async def free_symbol_input(message: Message):
    if not message.text: return
    text = message.text.strip().upper()

    if len(text) == 64 and text.isalnum():  # TxID
        await message.answer("🔍 Проверяю транзакцию...")
        success, msg, _ = check_tron_transaction(text, message.from_user.id)
        await message.answer(msg)
        return

    if len(text) >= 2 and text.isalnum():
        await predict_handler(message, text)

