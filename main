@dp.message(Command("broadcast"))
async def broadcast(message: Message):
    if message.from_user.id != ADMIN_ID: return
    text = message.text.replace("/broadcast", "").strip()
    if not text:
        await message.answer("❌ Напишите текст сообщения после команды.\nПример: `/broadcast Всем привет!`")
        return

    sent = 0
    for uid_str in users_db.keys():
        try:
            await bot.send_message(int(uid_str), text, parse_mode="HTML")
            sent += 1
            await asyncio.sleep(0.05)
        except:
            continue
    await message.answer(f"✅ Рассылка завершена!\nОтправлено: {sent} пользователям")


@dp.message(Command("listsubs"))
async def list_subscriptions(message: Message):
    if message.from_user.id != ADMIN_ID: return
    if not subscriptions:
        await message.answer("Подписок нет.")
        return
    text = "📋 <b>Активные подписки:</b>\n\n"
    for uid, sub in subscriptions.items():
        try:
            end = datetime.fromisoformat(sub["end_date"].replace("Z", ""))
            days_left = (end - datetime.utcnow()).days
            text += f"<code>{uid}</code> → {end.strftime('%d.%m.%Y')} ({days_left} дней)\n"
        except:
            text += f"<code>{uid}</code> — ошибка\n"
    await message.answer(text, parse_mode="HTML")


@dp.message(Command("users"))
async def show_users(message: Message):
    if message.from_user.id != ADMIN_ID: return
    if not users_db:
        await message.answer("Пользователей нет.")
        return
    text = "👥 <b>Последние пользователи:</b>\n\n"
    for uid, data in list(users_db.items())[-30:]:
        username = "@" + data.get("username", "") if data.get("username") else "—"
        text += f"<code>{uid}</code> | {username} | {data.get('first_name','')}\n"
    await message.answer(text, parse_mode="HTML")


