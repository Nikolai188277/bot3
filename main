# ===================== БАЗА =====================
def load_data(filename, default=None):
    try:
        with open(filename, 'r', encoding='utf-8') as f:
            return json.load(f)
    except:
        return default or {}

def save_data(filename, data):
    with open(filename, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

subscriptions = load_data(SUBSCRIPTIONS_FILE, {})
used_txids = load_data(USED_TXIDS_FILE, {})
users_db = load_data(USERS_FILE, {})
banned_users = load_data(BANNED_FILE, [])

# ===================== ПОДПИСКИ =====================
def is_user_active(user_id: int) -> bool:
    if user_id == ADMIN_ID: return True
    if user_id in banned_users: return False
    sub = subscriptions.get(str(user_id))
    if not sub: return False
    try:
        end_date = datetime.fromisoformat(sub["end_date"].replace("Z", ""))
        return end_date > datetime.utcnow()
    except:
        return False

def get_subscription_info(user_id: int):
    if user_id == ADMIN_ID:
        return "♾️ Администратор — безлимит"
    if user_id in banned_users:
        return "⛔ Вы заблокированы"
    sub = subscriptions.get(str(user_id))
    if not sub:
        return "❌ Нет активной подписки"
    try:
        end = datetime.fromisoformat(sub["end_date"].replace("Z", ""))
        days_left = max(0, (end - datetime.utcnow()).days + 1)
        return f"✅ Активна до {end.strftime('%d.%m.%Y')} ({days_left} дней)"
    except:
        return "❌ Ошибка подписки"

def activate_subscription(user_id: int, days: int = 30, plan: str = "paid"):
    user_str = str(user_id)
    end_date = datetime.utcnow() + timedelta(days=days)
    subscriptions[user_str] = {"end_date": end_date.isoformat() + "Z", "plan": plan}
    save_data(SUBSCRIPTIONS_FILE, subscriptions)

def remove_subscription(user_id: int):
    user_str = str(user_id)
    if user_str in subscriptions:
        del subscriptions[user_str]
        save_data(SUBSCRIPTIONS_FILE, subscriptions)

def ban_user(user_id: int):
    if user_id not in banned_users:
        banned_users.append(user_id)
        save_data(BANNED_FILE, banned_users)

def unban_user(user_id: int):
    if user_id in banned_users:
        banned_users.remove(user_id)
        save_data(BANNED_FILE, banned_users)

def save_user(user):
    user_id = str(user.id)
    if user_id not in users_db:
        users_db[user_id] = {
            "user_id": user.id,
            "username": user.username,
            "first_name": user.first_name,
            "first_start": datetime.utcnow().isoformat(),
        }
        save_data(USERS_FILE, users_db)

# ===================== TxID =====================
def is_txid_used(txid: str) -> bool:
    return txid in used_txids

def mark_txid_as_used(txid: str, user_id: int, amount: float, plan: str):
    used_txids[txid] = {
        "user_id": user_id,
        "amount": amount,
        "plan": plan,
        "timestamp": datetime.utcnow().isoformat()
    }
    save_data(USED_TXIDS_FILE, used_txids)

# ===================== ПРОВЕРКА ОПЛАТЫ =====================
def check_tron_transaction(txid: str, user_id: int):
    if is_txid_used(txid):
        return False, "❌ Эта транзакция уже была использована", 0

    try:
        url = "https://api.trongrid.io/wallet/gettransactionbyid"
        response = requests.post(url, json={"value": txid}, timeout=15)
        data = response.json()

        if not data or 'raw_data' not in data:
            return False, "❌ Транзакция не найдена", 0

        received_amount = 0.0
        for contract in data.get('raw_data', {}).get('contract', []):
            if contract.get('type') == 'TriggerSmartContract':
                param = contract.get('parameter', {}).get('value', {})
                if param.get('contract_address') == "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t":
                    if param.get('to_address', '').upper() == USDT_ADDRESS.upper():
                        received_amount = int(param.get('amount', 0)) / 1_000_000
                        break

        if received_amount == 0:
            return False, "❌ Не найдено USDT на адрес", 0

        for plan_key, plan in SUBSCRIPTION_PRICES.items():
            if abs(received_amount - plan["price"]) < 0.01:
                mark_txid_as_used(txid, user_id, received_amount, plan_key)
                activate_subscription(user_id, plan["days"], plan_key)
                return True, f"✅ Оплата {received_amount} USDT подтверждена!\nПодписка **{plan['name']}** активирована!", received_amount

        closest = min(SUBSCRIPTION_PRICES.values(), key=lambda p: abs(p["price"] - received_amount))
        expected = closest["price"]

        if received_amount < expected:
            missing = expected - received_amount
            return False, f"⚠️ Недостаточно!\nПолучено: {received_amount} USDT\nНужно: {expected} USDT\nДоплатите: **{missing:.2f}** USDT", received_amount
        else:
            extra = received_amount - expected
            mark_txid_as_used(txid, user_id, received_amount, "yearly")
            activate_subscription(user_id, closest["days"])
            return True, f"✅ Получено {received_amount} USDT (переплата {extra:.2f})\nПодписка активирована!", received_amount

    except Exception as e:
        return False, f"❌ Ошибка проверки: {str(e)}", 0

