# ===================== QR =====================
def generate_usdt_qr(amount: float, user_id: int):
    memo = f"bot_{user_id}_{int(datetime.utcnow().timestamp())}"
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(f"tron:{USDT_ADDRESS}?amount={amount}&memo={memo}")
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")
    bio = BytesIO()
    img.save(bio, format="PNG")
    bio.seek(0)
    return bio, memo

# ===================== КЛАВИАТУРА =====================
async def create_main_keyboard():
    global keyboard
    try:
        pairs = get_futures_pairs()
        buttons = [[KeyboardButton(text=f"🔮 {pair}")] for pair in pairs[:3]]
        buttons.extend([
            [KeyboardButton(text="📋 Показать все монеты")],
            [KeyboardButton(text="📊 Другая монета")],
            [KeyboardButton(text="💰 Подписка")],
            [KeyboardButton(text="⏱ 1ч"), KeyboardButton(text="⏱ 4ч"), KeyboardButton(text="⏱ 12ч")],
            [KeyboardButton(text="🧠 LSTM: ВКЛ" if use_lstm_mode else "🧠 LSTM: ВЫКЛ")]
        ])
        
        keyboard = ReplyKeyboardMarkup(
            keyboard=buttons,
            resize_keyboard=True,
            is_persistent=True,           # ← Важно для Desktop
            input_field_placeholder="Выберите монету или команду..."
        )
    except:
        keyboard = ReplyKeyboardMarkup(
            keyboard=[[KeyboardButton(text="🔮 BTCUSDT")]],
            resize_keyboard=True,
            is_persistent=True
        )

# ===================== LSTM + ВРЕМЯ =====================
@dp.message(lambda m: m.text and "LSTM" in m.text)
async def toggle_lstm(message: Message):
    global use_lstm_mode
    use_lstm_mode = not use_lstm_mode
    await message.answer(f"🧠 LSTM **{'ВКЛ' if use_lstm_mode else 'ВЫКЛ'}**", parse_mode="HTML")
    await create_main_keyboard()
    reply_markup=keyboard

@dp.message(lambda m: m.text in ["⏱ 1ч", "⏱ 4ч", "⏱ 12ч"])
async def change_horizon(message: Message):
    global current_horizon
    if "1ч" in message.text: current_horizon = 3600
    elif "4ч" in message.text: current_horizon = 14400
    elif "12ч" in message.text: current_horizon = 43200
    await message.answer(f"✅ Время прогноза изменено на <b>{current_horizon // 3600} часов</b>", parse_mode="HTML")

# ===================== ПРОГНОЗ =====================
async def predict_handler(message: Message, symbol: str):
    if not is_user_active(message.from_user.id):
        await message.answer("⛔ Доступ закрыт.\nНажмите «💰 Подписка»", parse_mode="HTML")
        return

    symbol = symbol.upper().strip()
    if not any(symbol.endswith(x) for x in ["USDT", "USDC", "BUSD"]):
        symbol += "USDT"

    await message.answer(
        FULL_DISCLAIMER + f"⏳ Анализирую <b>{symbol}</b> на {current_horizon // 3600} час...",
        parse_mode="HTML"
    )

    try:
        global weights
        weights = load_json("prediction_weights.json")

        result = predict_symbol(
            symbol=symbol,
            horizon_seconds=current_horizon,
            use_lstm=use_lstm_mode,
            use_n_candles=False,
            weights_dict=weights,
            history_limit=None,
            n_candles=500,
            use_dev_forecast=False
        )

        if not result:
            await message.answer("❌ Не удалось получить данные по символу.")
            return

        text = f"""
📊 <b>{result.get('symbol', symbol)}</b> — Прогноз на <b>{current_horizon // 3600}ч</b>

🔼 <b>Up:</b>   <b>{result.get('up_prob', 0)}%</b>
🔽 <b>Down:</b> <b>{result.get('down_prob', 0)}%</b>
📊 <b>Diff:</b> <b>{result.get('prob_diff', 0)}%</b>

💰 <b>Текущая цена:</b> <b>${result.get('current_price', '—')}</b>
🧠 <b>Модель:</b> RandomForest {'+ LSTM' if use_lstm_mode else ''}

📈 <b>Дополнительные данные:</b>
• Long Volume: <b>{result.get('long_volume', 0):,}</b>
• Short Volume: <b>{result.get('short_volume', 0):,}</b>
• Funding Rate: <b>{result.get('current_funding_rate', 0)} bps</b>
• Funding MA: <b>{result.get('funding_rate_ma', 0)} bps</b>
• Long/Short Ratio: <b>{result.get('long_short_ratio', 1.0)}</b>
• Open Interest: <b>{result.get('oi', 0):,}</b>

📊 <b>Историческая точность:</b> {result.get('accuracy', 0)}% | Стрик: {result.get('streak', 0)}
        """.strip()

        # ==================== КНОПКИ ====================
        ref_code = "EDO336NQ"
        futures_url = f"https://www.binance.com/en/futures/{symbol}?ref={ref_code}"
        spot_url = f"https://www.binance.com/en/trade/{symbol}?ref={ref_code}"

        inline_kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text=f"🚀 Торговать {symbol} на Futures Binance", url=futures_url)],
            [InlineKeyboardButton(text=f"🚀 Торговать {symbol} на Spot Binance", url=spot_url)]
        ])

        await message.answer(text, parse_mode="HTML", reply_markup=inline_kb)

    except Exception as e:
        if "Invalid symbol" in str(e):
            await message.answer(f"❌ Неправильный символ: <b>{symbol}</b>")
        else:
            await message.answer("❌ Ошибка при расчёте прогноза.")
        traceback.print_exc()

