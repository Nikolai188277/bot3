@dp.message(Command("admin"))
async def admin_panel(message: Message):
    if message.from_user.id != ADMIN_ID:
        await message.answer("⛔ Доступ запрещён.")
        return
    active = len([u for u in subscriptions if is_user_active(int(u))])
    await message.answer(f"""
👑 <b>Админ-панель</b>

📊 Статистика:
• Пользователей: <b>{len(users_db)}</b>
• Активных подписок: <b>{active}</b>
• Заблокировано: <b>{len(banned_users)}</b>

🔧 Команды:
• /addsub <id> <days>
• /delsub <id>
• /ban <id>
• /unban <id>
• /broadcast <текст>
• /listsubs
• /users
• /usedtx
• /status
    """, parse_mode="HTML")


@dp.message(Command("addsub"))
async def add_subscription(message: Message):
    if message.from_user.id != ADMIN_ID: return
    try:
        _, uid, days = message.text.split()
        activate_subscription(int(uid), int(days))
        await message.answer(f"✅ Подписка на {days} дней добавлена пользователю <code>{uid}</code>", parse_mode="HTML")
    except:
        await message.answer("❌ Формат: /addsub <user_id> <days>")


@dp.message(Command("delsub"))
async def del_subscription(message: Message):
    if message.from_user.id != ADMIN_ID: return
    try:
        _, uid = message.text.split()
        remove_subscription(int(uid))
        await message.answer(f"✅ Подписка пользователя <code>{uid}</code> удалена", parse_mode="HTML")
    except:
        await message.answer("❌ Формат: /delsub <user_id>")


